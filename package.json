{
  "name": "demowebshop-ui-api-automation",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test:q1": "npx playwright test tests/q1_invalid_login.spec.js",
    "test:q2": "npx playwright test tests/q2_register_cart.spec.js",
    "test:q3": "npx playwright test tests/q3_e2e_checkout.spec.js",
    "test:ui": "npx playwright test",
    "test:api": "newman run api-tests/jsonplaceholder-users.postman_collection.json -r cli,html --reporter-html-export reports/newman-report.html",
    "test:all": "npm run test:ui && npm run test:api && npm run report:allure:generate",
    "report:html": "npx playwright show-report",
    "report:allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "report:allure:open": "npx allure open allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}